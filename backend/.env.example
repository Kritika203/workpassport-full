# Local: copy to .env and load it in your terminal before running Django.
# Development only: generate a fresh key before deployment.
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# No DATABASE_URL uses SQLite for local development.
# PostgreSQL example (never commit real credentials):
# DATABASE_URL=postgresql://workpassport:password@localhost:5432/workpassport
# DJANGO_HTTPS_ONLY=true

# Opt in to browser demo sessions in production only if needed.
ALLOW_DEMO_SESSIONS=true
# Set your own strong value; do not commit actual passwords.
DEMO_MAYA_PASSWORD=

# For live deployment: use your real public URLs.
WEB_FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
DEFAULT_FROM_EMAIL=noreply@example.invalid
# Django prints reset links to the terminal in development only.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Recommended on Render Free: Brevo HTTPS email API (SMTP ports are blocked).
# Verify your sender in Brevo and configure BOTH variables below.
# Remove/comment EMAIL_BACKEND=console above to enable automatic selection.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=WorkPassport <verified-sender@yourdomain.example>
# For other hosts, SMTP is also supported:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# Optional private file storage (required if your host has ephemeral disks):
# PRIVATE_S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=

# WhatsApp Shield bot (Meta Cloud API test or business number)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=

# Optional: LibreTranslate-compatible POST endpoint hosted by you or an approved provider.
# Use HTTPS, verify support for Nepali (`ne`), and review the provider's privacy terms.
# Without this setting, bilingual chat still works in original text only.
WP_TRANSLATE_ENDPOINT=
WP_TRANSLATE_API_KEY=

# Optional AI help chatbot: approved OpenAI-compatible chat-completions endpoint.
# If unset, guided conversational help still works without paid AI.
WP_HELP_AI_ENDPOINT=
WP_HELP_AI_MODEL=
WP_HELP_AI_KEY=
